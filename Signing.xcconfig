// Ad-hoc signing ("Sign to Run Locally") builds on any Mac without an Apple account.
// To sign with your own certificate instead, create Local.xcconfig (not committed) with:
//   DEVELOPMENT_TEAM = YOURTEAMID
//   CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Local.xcconfig"
